<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>RemoteTechMapFix</RootNamespace>
    <AssemblyName>RemoteTechMapFix</AssemblyName>
    <LangVersion>8</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Release tags are v-prefixed (v0.1.0); MinVer ignores them without this. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="4.*" PrivateAssets="All" />
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- Hard dependencies: the near-plane clipping patches RemoteTech's NetworkLine/NetworkCone
       via Harmony. -->
  <ItemGroup>
    <ModReference Include="RemoteTech">
      <DLLPath>GameData/RemoteTech/Plugins/RemoteTech.dll</DLLPath>
      <CKANIdentifier>RemoteTech</CKANIdentifier>
    </ModReference>
    <ModReference Include="0Harmony">
      <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
      <CKANIdentifier>Harmony2</CKANIdentifier>
    </ModReference>
  </ItemGroup>

  <!-- VERSION deliberately unset: KSPBuildTools fills it from $(FileVersion) after MinVer runs. -->
  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)RemoteTechMapFix.version</Destination>
      <URL>https://github.com/Machine-Maker/RemoteTechMapFix/releases/latest/download/RemoteTechMapFix.version</URL>
      <Download>https://github.com/Machine-Maker/RemoteTechMapFix/releases/latest</Download>
      <KSP_Version>1.12</KSP_Version>
      <KSP_Version_Min>1.8</KSP_Version_Min>
      <KSP_Version_Max>1.12</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>

</Project>
